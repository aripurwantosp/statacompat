   \code{0} \tab \code{no} \tab \code{no} \cr
   \code{NA} / \code{NaN} (Stata \code{.}) \tab \strong{\code{yes}} \tab \code{c} \cr
   \code{TRUE} \tab \code{yes} \tab \code{yes} \cr
   \code{FALSE} \tab \code{no} \tab \code{no} \cr
